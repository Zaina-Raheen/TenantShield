# TENANTSHIELD backend. Safe defaults: with NOTHING set, the app runs in "production" mode:
# no dev controls, no vulnerable demo, demo API always behaves as fixed.

# Development environment (enables dev endpoints; they still accept loopback clients only).
TENANTSHIELD_ENV=development

# Explicit opt-in for the intentionally vulnerable demo. Only honoured when TENANTSHIELD_ENV=development.
# `python run.py` sets this for you (use `python run.py --safe` to leave it off).
TENANTSHIELD_ENABLE_VULNERABLE_DEMO=1

# Optional: allow NON-loopback clients to use read-only GET endpoints. Never allows state changes. Default: off.
# TENANTSHIELD_ALLOW_REMOTE_READS=0

# TENANTSHIELD_DATABASE_URL=sqlite:///./data/tenantshield.db
# TENANTSHIELD_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# TENANTSHIELD_ALLOWED_HOSTS=127.0.0.1,localhost,testserver

# NOT configurable: the engine only tests the bundled demo API, in-process (no URL, no port).
# TENANTSHIELD_DEMO_API_BASE_URL is rejected at startup; TENANTSHIELD_DEMO_TARGET accepts only "inprocess".
